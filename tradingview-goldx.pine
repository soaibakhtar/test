//@version=5
indicator("GoldX AI Trader — TradingView Bridge", overlay=true, max_labels_count=200)

// Use on XAUUSD. Create a TradingView alert using: Any alert() function call.
pivotLen = input.int(3, "Swing length", minval=2, maxval=10)
showLevels = input.bool(true, "Show structure levels")

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow = na
if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow := pl

bullBos = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bearBos = not na(lastLow) and close < lastLow and close[1] >= lastLow

// Simple displacement/FVG proxy from three candles. These are explicitly labeled
// as TradingView-computed context and should not be treated as guaranteed signals.
bullFvg = low > high[2]
bearFvg = high < low[2]

var string structure = "RANGE"
if bullBos
    structure := "BOS BULL"
if bearBos
    structure := "BOS BEAR"

plot(showLevels ? lastHigh : na, "Swing High", color=color.new(color.red, 45), style=plot.style_linebr)
plot(showLevels ? lastLow : na, "Swing Low", color=color.new(color.green, 45), style=plot.style_linebr)
plotshape(bullBos, title="Bull BOS", style=shape.labelup, text="BOS↑", location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
plotshape(bearBos, title="Bear BOS", style=shape.labeldown, text="BOS↓", location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
plotshape(bullFvg, title="Bull FVG", style=shape.circle, location=location.belowbar, color=color.new(color.green, 20), size=size.tiny)
plotshape(bearFvg, title="Bear FVG", style=shape.circle, location=location.abovebar, color=color.new(color.red, 20), size=size.tiny)

f_num(x) => str.tostring(x, format.mintick)
f_json(s) => str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\"")

payload = '{' +
  '"source":"tradingview",' +
  '"symbol":"' + syminfo.tickerid + '",' +
  '"timeframe":"' + timeframe.period + '",' +
  '"time":' + str.tostring(time) + ',' +
  '"open":' + f_num(open) + ',' +
  '"high":' + f_num(high) + ',' +
  '"low":' + f_num(low) + ',' +
  '"close":' + f_num(close) + ',' +
  '"volume":' + f_num(volume) + ',' +
  '"swingHigh":' + (na(lastHigh) ? "null" : f_num(lastHigh)) + ',' +
  '"swingLow":' + (na(lastLow) ? "null" : f_num(lastLow)) + ',' +
  '"structure":"' + f_json(structure) + '",' +
  '"bullBos":' + str.tostring(bullBos) + ',' +
  '"bearBos":' + str.tostring(bearBos) + ',' +
  '"bullFvg":' + str.tostring(bullFvg) + ',' +
  '"bearFvg":' + str.tostring(bearFvg) +
  '}'

if barstate.isconfirmed
    alert(payload, alert.freq_once_per_bar_close)
